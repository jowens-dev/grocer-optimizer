# AisleOne Configuration Template
# Environment: 'development' or 'production'
AISLEONE_ENV=development

# JWT Cryptographic Secret Key (Set a unique random value in production)
# You can generate a hex string using: python -c "import secrets; print(secrets.token_hex(32))"
AISLEONE_SECRET_KEY=aisleone-default-secret-key-development-only

# Cross-Origin Allowed Domains (comma-separated, '*' allows all)
ALLOWED_ORIGINS=*

# Optional: ScraperAPI proxy token for real Instacart price extraction
# Leave empty to use regional fallback generator
SCRAPERAPI_KEY=
